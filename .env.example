# Copy to backend/.env and fill in. Never commit .env.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://slidegen:slidegen@localhost:5432/slidegen

# LLM: any OpenAI-compatible endpoint (Gemini free tier, Groq, OpenRouter :free, local Ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Auth: Google OAuth client and a long random string for signing session cookies
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Key used to encrypt stored OAuth refresh tokens (Fernet key)
TOKEN_ENCRYPTION_KEY=
